pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
               sh "echo 'Building Image .....'"
            }
        }
        stage('Test') {
            steps (
               sh "echo 'Testing Image.....'"
            )
        }
        stage('Deploy') {
            steps {
               sh "echo 'Deploying Image.....'"
            }
        }
    }
}