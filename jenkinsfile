pipeline {
    agent any
    stages {
        //stage('Git Checkout') {
        //    steps {
        //        echo 'Checking out Git repository'
        //        git 'https://github.com/vipin0102/jenkins.git'
        //    }
        //}
        stage('Docker Login') {
            steps {
               echo 'Docker login'
               sh '''
                        echo "Attentive@123" | docker login \
                        -u "vipin0102" --password-stdin
                    '''
            }
        }
        stage('Build Image') {
            steps {
               echo 'Building Image.....'
               sh 'docker build --no-cache -t vipin0102/nginx:latest .'
            }
        }
        stage('Docker push') {
            steps {
               echo 'Docker push Image.....'
               sh 'docker push vipin0102/nginx:latest'
            }
        }
        stage('Deploy') {
            steps {
               echo 'Deploying application.....'
               sh 'docker run --name nginx -itd vipin0102/nginx:latest'
            }
        }
        stage('Clean WORKDIR') {
            steps {
               echo 'Cleaning workdirectory.....'
               cleanWs()
            }
        }                
    }
}