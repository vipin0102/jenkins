
pipeline {
    agent any

    environment {
        IMAGE_TAG = 'v3'
        IMAGE_NAME = 'vipin0102/nginx-swarm'
        SERVICE_NAME = 'nginx-stack_nginx'
    }

    stages {

        // ================= MAIN BRANCH =================

        stage('Docker Build & Credentials - MAIN') {
            when {
                branch 'main'
            }
            steps {
                echo 'Docker build with credentials - MAIN'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    )
                ]) {
                    sh '''
                        echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin

                        docker build --no-cache -t ${IMAGE_NAME}:${IMAGE_TAG} .

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Docker Image Pull & Deploy - MAIN') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deployment application - MAIN'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    ),
                    string(
                        credentialsId: 'INFRD_SERVER_IP',
                        variable: 'INFRD_SERVER_IP'
                    )
                ]) {
                    sshagent(credentials: ['ec2-ssh-key']) {

                        // sh '''
                        //     echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin
                        //     docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                        // '''

                        // sh 'docker service update --force --image ${IMAGE_NAME}:${IMAGE_TAG} ${SERVICE_NAME}'

                        // sh 'ssh ubuntu@$INFRD_SERVER_IP "docker run --name web -itd -p 7777:80 ${IMAGE_NAME}:${IMAGE_TAG}"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker service ls"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker --version"'
                    }
                }
            }
        }


        // ================= DEV BRANCH =================

        stage('Docker Build & Credentials - DEV') {
            when {
                branch 'dev'
            }
            steps {
                echo 'Docker build with credentials - DEV'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    )
                ]) {
                    sh '''
                        echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin

                        docker build --no-cache -t ${IMAGE_NAME}:${IMAGE_TAG} .

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Docker Image Pull & Deploy - DEV') {
            when {
                branch 'dev'
            }
            steps {
                echo 'Deployment application - DEV'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    ),
                    string(
                        credentialsId: 'INFRD_SERVER_IP',
                        variable: 'INFRD_SERVER_IP'
                    )
                ]) {
                    sshagent(credentials: ['ec2-ssh-key']) {

                        // sh '''
                        //     echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin
                        //     docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                        // '''

                        // sh 'docker service update --force --image ${IMAGE_NAME}:${IMAGE_TAG} ${SERVICE_NAME}'

                        // sh 'ssh ubuntu@$INFRD_SERVER_IP "docker run --name web -itd -p 7777:80 ${IMAGE_NAME}:${IMAGE_TAG}"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker service ls"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker --version"'
                    }
                }
            }
        }


        // ================= UAT BRANCH =================

        stage('Docker Build & Credentials - UAT') {
            when {
                branch 'uat'
            }
            steps {
                echo 'Docker build with credentials - UAT'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    )
                ]) {
                    sh '''
                        echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin

                        docker build --no-cache -t ${IMAGE_NAME}:${IMAGE_TAG} .

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Docker Image Pull & Deploy - UAT') {
            when {
                branch 'uat'
            }
            steps {
                echo 'Deployment application - UAT'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercreds',
                        passwordVariable: 'dockerpassword',
                        usernameVariable: 'dockerbuild'
                    ),
                    string(
                        credentialsId: 'INFRD_SERVER_IP',
                        variable: 'INFRD_SERVER_IP'
                    )
                ]) {
                    sshagent(credentials: ['ec2-ssh-key']) {

                        // sh '''
                        //     echo "$dockerpassword" | docker login -u "$dockerbuild" --password-stdin
                        //     docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                        // '''

                        // sh 'docker service update --force --image ${IMAGE_NAME}:${IMAGE_TAG} ${SERVICE_NAME}'

                        // sh 'ssh ubuntu@$INFRD_SERVER_IP "docker run --name web -itd -p 7777:80 ${IMAGE_NAME}:${IMAGE_TAG}"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker service ls"'

                        sh 'ssh -o StrictHostKeyChecking=accept-new ubuntu@$INFRD_SERVER_IP "docker --version"'
                    }
                }
            }
        }

    }
}
