pipeline {
    agent any
    stages {
        stage('Git Checkout') {
            steps {
                echo 'Checking out Git repository'
                git 'https://github.com/vipin0102/jenkins.git'
            }
        }
        stage('Build') {
            steps {
               sh "echo 'Building Image .....'"
            }
        }
        stage('Test') {
            steps (
               sh "echo 'Testing Image.....'"
            )
        }
        stage('Deploy') {
            steps {
               sh "echo 'Deploying Image.....'"
            }
        }
    }
}